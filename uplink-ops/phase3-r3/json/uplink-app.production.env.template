# Uplink production environment template (r3.2). The OWNER pastes this into the EasyPanel uplink-app-prod Environment tab and replaces every {{...}} himself.
# No secret value is stored here. Lines starting with # are not part of the environment.
# PM ruling (plan v2.8): separate staging and production images from the same accepted source commit; the four origin keys agree within each environment.
# This template is ONLY for the production image built with public_url=https://uplink.epic.dm (see json/codex-image-contract.template.json). Never paste it into the other environment.
# --- origin / database (plan v2.2 section 3) ---
DB_DRIVER=pg
DB_POOL_MAX=10
PORT=3000
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://uplink.epic.dm
AUTH_URL=https://uplink.epic.dm
NEXTAUTH_URL=https://uplink.epic.dm
PLATFORM_APP_URL=https://uplink.epic.dm
AUTH_TRUST_HOST=true
WORKSPACE_BASE_DOMAIN=uplink.epic.dm
# --- white-label (plan v2.2 section 3 items 19-20); text-branding candidates, no contacts invented ---
SHOW_VENDOR_BRANDING=false
PLATFORM_NAME=Uplink
PLATFORM_HOME_URL=https://uplink.epic.dm
PLATFORM_EMAIL_FROM_NAME=Uplink by EPIC
PLATFORM_EMAIL_FOOTER=Uplink by EPIC Communications
PLATFORM_SUPPORT_EMAIL={{OWNER_SUPPORT_EMAIL_OR_EMPTY}}
PLATFORM_LOGO_URL={{OWNER_LOGO_URL_OR_EMPTY}}
PLATFORM_FAVICON_URL={{OWNER_FAVICON_URL_OR_EMPTY}}
# --- owner-entered secrets (never stored anywhere else by agents). Every slot below is specific to the production environment: its own database credentials,
# ENCRYPTION_KEY and auth/session secrets. Never reuse or copy a value from the other environment. ---
# DATABASE_URL target: host uplink_uplink-db-prod database uplink
DATABASE_URL={{OWNER_ENTERS_PRODUCTION_DATABASE_URL}}
AUTH_SECRET={{OWNER_ENTERS_PRODUCTION_AUTH_SECRET}}
NEXTAUTH_SECRET={{OWNER_ENTERS_PRODUCTION_NEXTAUTH_SECRET}}
ENCRYPTION_KEY={{OWNER_ENTERS_PRODUCTION_ENCRYPTION_KEY}}
# --- pending the Codex Phase 1 configuration contract (do not invent; see contract.json pending_codex_keys) ---
{{CODEX_READINESS_PATH_NOTE}}
{{CODEX_AI_MODE_KEY}}={{CODEX_AI_MODE_VALUE}}
{{CODEX_CHATWOOT_FLAG_KEY}}={{CODEX_CHATWOOT_FLAG_VALUE}}
{{CODEX_VOICE_FLAG_KEY}}={{CODEX_VOICE_FLAG_VALUE}}
