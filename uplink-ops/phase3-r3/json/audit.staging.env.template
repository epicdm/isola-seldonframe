# Environment the OWNER enters for uplink-backup-audit, ONLY if scoped list access to the destination is confirmed (acceptance test T6); this template does not ask for a new key.
# AUDIT_ENV selects the backup prefixes uplink/staging/daily and uplink/staging/weekly; the other environment's prefixes are never listed.
AUDIT_ENV=staging
AWS_ACCESS_KEY_ID={{OWNER_ENTERS_STAGING_AUDIT_ACCESS_KEY_ID}}
AWS_SECRET_ACCESS_KEY={{OWNER_ENTERS_STAGING_AUDIT_SECRET_ACCESS_KEY}}
AWS_DEFAULT_REGION={{OWNER_STORAGE_REGION}}
S3_ENDPOINT={{OWNER_STORAGE_ENDPOINT}}
S3_BUCKET={{OWNER_STORAGE_BUCKET}}
SERVICE_START={{SERVICE_START_DATE}}
