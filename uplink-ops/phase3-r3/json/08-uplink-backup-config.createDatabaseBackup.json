{
  "_purpose": "EasyPanel-native backup schedules for uplink-db: separate daily and weekly entries with COUNT retention (retention = number of backups kept). Whether EasyPanel counts only successful runs is unproven: the backup audit service/offline audit measures real restore points independently.",
  "calls": [
    {
      "procedure": "createDatabaseBackup",
      "input": {
        "projectName": "uplink",
        "serviceName": "uplink-db",
        "databaseName": "uplink",
        "enabled": true,
        "retention": 14,
        "schedule": "15 2 * * *",
        "storageProviderId": "{{BACKUP_STORAGE_PROVIDER_ID}}",
        "storageProviderPath": "uplink/daily"
      }
    },
    {
      "procedure": "createDatabaseBackup",
      "input": {
        "projectName": "uplink",
        "serviceName": "uplink-db",
        "databaseName": "uplink",
        "enabled": true,
        "retention": 8,
        "schedule": "15 3 * * 0",
        "storageProviderId": "{{BACKUP_STORAGE_PROVIDER_ID}}",
        "storageProviderPath": "uplink/weekly"
      }
    }
  ]
}
